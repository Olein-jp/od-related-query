#: scripts/class-sample-content-seeder.php:306
#, php-format
msgid "This sample post is used to preview “%s”."
msgstr "「%s」の表示確認に使用するサンプル投稿です。"

#: scripts/class-sample-content-seeder.php:310
msgid "What to check"
msgstr "確認ポイント"

#: scripts/class-sample-content-seeder.php:311
msgid "Confirm that posts sharing categories or tags appear in the related-content section of the single-post template."
msgstr "カテゴリーやタグが共通する投稿が、個別投稿テンプレートの関連記事セクションに表示されることを確認してください。"

#: scripts/class-sample-content-seeder.php:425
msgid "The single template is already customized, so it was not changed."
msgstr "個別投稿テンプレートはすでにカスタマイズされているため、変更しませんでした。"

#: scripts/class-sample-content-seeder.php:434
msgid "The active theme does not provide templates/single.html."
msgstr "有効なテーマに templates/single.html がありません。"

#: scripts/class-sample-content-seeder.php:466
msgid "Single Posts"
msgstr "個別投稿"

#: scripts/class-sample-content-seeder.php:515
#: src/index.js:364
msgid "Related content"
msgstr "関連記事"

#: scripts/class-sample-content-seeder.php:516
#: src/variation.js:175
msgid "No related content found."
msgstr "関連記事が見つかりませんでした。"

#: src/class-related-query.php:153
msgid "Post ID used as the source for related content."
msgstr "関連記事の判定元として使用する投稿 ID。"

#: src/class-related-query.php:159
msgid "Post ID used only as the template editor preview source."
msgstr "テンプレートエディターのプレビュー元としてのみ使用する投稿 ID。"

#: src/class-related-query.php:165
msgid "Ordering used for related content."
msgstr "関連記事に使用する並び順。"

#: src/class-related-query.php:171
msgid "Taxonomies used to determine related content."
msgstr "関連記事の判定に使用するタクソノミー。"

#: src/class-related-query.php:178
msgid "Taxonomies excluded when determining related content."
msgstr "関連記事の判定から除外するタクソノミー。"

#: src/index.js:34
msgid "Select a post type in the Query settings to load its taxonomies."
msgstr "クエリー設定で投稿タイプを選択すると、そのタクソノミーを読み込みます。"

#: src/index.js:41
msgid "The source and target post types do not share any public taxonomies. Related content cannot be determined for this combination."
msgstr "判定元と表示対象の投稿タイプに共通する公開タクソノミーがありません。この組み合わせでは関連記事を判定できません。"

#: src/index.js:47
msgid "No public taxonomies are available for the selected post type."
msgstr "選択した投稿タイプで利用できる公開タクソノミーがありません。"

#: src/index.js:370
msgid "Choose the taxonomies used to find shared terms. New public taxonomies are selected automatically."
msgstr "共通タームの検索に使用するタクソノミーを選択してください。新しい公開タクソノミーは自動的に選択されます。"

#: src/index.js:376
msgid "Related content order"
msgstr "関連記事の並び順"

#: src/index.js:377
msgid "Relevance counts shared terms. Ties use newest content first."
msgstr "関連度は共通ターム数で判定します。同数の場合は新しい投稿を優先します。"

#: src/index.js:387
msgid "Date"
msgstr "日付"

#: src/index.js:391
msgid "Relevance"
msgstr "関連度"

#: src/index.js:405
msgid "Loading preview source posts…"
msgstr "プレビュー元の投稿を読み込んでいます…"

#: src/index.js:419
msgid "Preview source posts could not be loaded."
msgstr "プレビュー元の投稿を読み込めませんでした。"

#: src/index.js:434
msgid "No published posts are available for this post type. Publish a post to preview related content in the template editor."
msgstr "この投稿タイプには公開済みの投稿がありません。テンプレートエディターで関連記事をプレビューするには、投稿を公開してください。"

#: src/index.js:444
msgid "Preview source post"
msgstr "プレビュー元の投稿"

#: src/index.js:445
msgid "Used only for the template editor preview. The frontend always uses the post being viewed."
msgstr "テンプレートエディターのプレビューにのみ使用します。フロントエンドでは常に表示中の投稿を使用します。"

#: src/index.js:459
msgid "(Untitled)"
msgstr "（タイトルなし）"

#: src/index.js:471
msgid "Loading available taxonomies…"
msgstr "利用可能なタクソノミーを読み込んでいます…"

#: src/index.js:484
msgid "The available taxonomies could not be loaded."
msgstr "利用可能なタクソノミーを読み込めませんでした。"

#: src/index.js:527
msgid "Select at least one taxonomy to display related content. With no taxonomies selected, this Query Loop returns no results."
msgstr "関連記事を表示するには、タクソノミーを1つ以上選択してください。タクソノミーが未選択の場合、この Query Loop は結果を返しません。"

#: src/variation.js:109
msgid "Related Content"
msgstr "関連記事"

#: src/variation.js:110
msgid "Displays content that shares a category, tag, or public custom taxonomy term with the current post."
msgstr "現在の投稿とカテゴリー、タグ、または公開カスタムタクソノミーのタームが共通する投稿を表示します。"

#: src/variation.js:116
msgid "related"
msgstr "関連"

#: src/variation.js:117
msgid "posts"
msgstr "投稿"
